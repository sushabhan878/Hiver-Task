# SupportPilot runs fully local via Ollama - no API keys required.
# If you prefer a hosted LLM instead, set these and adapt src/llm/client.py.
SUPPORTPILOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
SUPPORTPILOT_OLLAMA_CHAT_MODEL=qwen2.5:3b
SUPPORTPILOT_OLLAMA_EMBED_MODEL=nomic-embed-text

# Example hosted alternative (not used by default):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
