# Normalize line endings and mark generated/binary artifacts so Git
# handles them correctly on every platform.
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts need LF
*.sh text eol=lf

# Notebooks and JSON can be large; keep diffs sane
*.ipynb text
*.json text

# Binary artifacts — never diff/merge
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.pkl binary
*.npy binary
*.lock linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
